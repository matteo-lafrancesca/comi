datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  /// Pseudo public, stocké en minuscules (unicité insensible à la casse). Null tant qu'il n'est pas choisi.
  pseudo        String?         @unique
  photoUrl      String?         @map("photo_url")
  passwordHash  String          @map("password_hash")
  weekStartDay  Int             @default(0) @map("week_start_day") // 0=Lun, 1=Mar, 2=Mer, 3=Jeu, 4=Ven, 5=Sam, 6=Dim
  createdAt     DateTime        @default(now()) @map("created_at")
  repas        Repas[]
  programmation Programmation[]
  shoppingList  ShoppingListItem[]
  shoppingListExtras ShoppingListExtra[]
  refreshTokens RefreshToken[]
  friendRequestsSent     Friendship[] @relation("FriendshipRequester")
  friendRequestsReceived Friendship[] @relation("FriendshipAddressee")
  savedRepas    RepasSaved[]

  @@map("users")
}

model Repas {
  id            Int               @id @default(autoincrement())
  userId        Int               @map("user_id")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  titre         String
  recette       String?
  photoUrl      String?           @map("photo_url")
  /// Visible par les amis de l'auteur (privé par défaut).
  isPublic      Boolean           @default(false) @map("is_public")
  createdAt     DateTime          @default(now()) @map("created_at")
  ingredients   RepasIngredient[]
  programmation Programmation[]
  shoppingListExtras ShoppingListExtra[]
  savedBy       RepasSaved[]

  @@map("repas")
  @@index([userId])
  @@index([userId, isPublic])
}

model Ingredient {
  id           Int                @id @default(autoincrement())
  nom          String             @unique
  categorie    String             // e.g., "fruits-legumes", "epicerie-salee"
  repas        RepasIngredient[]
  shoppingList ShoppingListItem[]
  shoppingListExtras ShoppingListExtra[]

  @@map("ingredients")
}

model RepasIngredient {
  id           Int        @id @default(autoincrement())
  repasId      Int        @map("repas_id")
  repas        Repas      @relation(fields: [repasId], references: [id], onDelete: Cascade)
  ingredientId Int        @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantite     Float?
  unite        String?

  @@map("repas_ingredients")
  @@index([repasId])
  @@index([ingredientId])
}

model Programmation {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repasId Int      @map("repas_id")
  repas   Repas    @relation(fields: [repasId], references: [id], onDelete: Cascade)
  date    DateTime
  heure   Int      // 0 = midi, 1 = soir

  @@unique([userId, date, heure])
  @@map("programmation")
  @@index([userId])
  @@index([repasId])
}

model ShoppingListItem {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId Int        @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantite     Float?
  unite        String?
  /// Unité normalisée (minuscules, "" si absente) : sert de clé d'unicité, car NULL est distinct en SQL.
  uniteKey     String     @default("") @map("unite_key")
  isChecked    Boolean    @default(false) @map("is_checked")
  week         Int
  year         Int
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([userId, week, year, ingredientId, uniteKey])
  @@map("shopping_list_items")
}

model ShoppingListExtra {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId Int?       @map("ingredient_id")
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantite     Float?
  unite        String?
  repasId      Int?       @map("repas_id")
  repas        Repas?     @relation(fields: [repasId], references: [id], onDelete: Cascade)
  week         Int
  year         Int
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("shopping_list_extras")
  @@index([userId])
  @@index([repasId])
  @@index([ingredientId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([userId])
  @@index([token])
}


/// Demande d'ami (`pending`) ou amitié (`accepted`). Une seule ligne par paire, quel que soit le sens.
model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int      @map("requester_id")
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId Int      @map("addressee_id")
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "accepted"
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([requesterId, addresseeId])
  @@map("friendships")
  @@index([addresseeId])
}

/// Recette d'un ami ajoutée à son carnet : un lien, pas une copie (supprimé avec le repas).
model RepasSaved {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repasId   Int      @map("repas_id")
  repas     Repas    @relation(fields: [repasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, repasId])
  @@map("repas_saved")
  @@index([repasId])
}
