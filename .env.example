# Base de données SQLite locale
DATABASE_URL=

# Token Uploadthing pour le stockage des images
# Remplacez par votre token de projet Uploadthing
UPLOADTHING_TOKEN=

# Secret JWT pour signer les tokens localement
JWT_SECRET=

# Clé API Gemini (analyse de photo de plat -> recette)
GEMINI_API_KEY=
# Instance servie sous un autre chemin (ex. préproduction) — laisser vide pour la prod (/comi).
# NEXT_PUBLIC_BASE_PATH est lu au build : relancer `npm run build` après l'avoir changé.
# NEXT_PUBLIC_BASE_PATH=/comi/dev
# Préfixe des cookies de session, obligatoire si deux instances partagent le domaine (avec un JWT_SECRET différent).
# SESSION_COOKIE_PREFIX=dev_
